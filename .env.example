# Modèle de configuration de la pile Nextcloud de l'École.
# Copiez ce fichier en .env (ignoré par git), puis remplacez chaque valeur.
# Toutes les valeurs ci-dessous sont factices. Le script d'acceptation refuse
# de tourner tant qu'un mot de passe a encore sa valeur d'exemple.

# --- Nom de domaine et reverse proxy de l'École (prérequis #7) ---------------

# Nom de domaine public attribué à Nextcloud, sans protocole.
# Utilisé pour trusted_domains.
NEXTCLOUD_DOMAIN=cloud.ecole.example

# Adresse publique complète du service, utilisée pour overwrite.cli.url
# (liens générés par les tâches de fond et par occ).
NEXTCLOUD_PUBLIC_URL=https://cloud.ecole.example

# Adresse IP (ou plage CIDR) du reverse proxy de l'École vue par le serveur
# Nextcloud. Plusieurs valeurs possibles, séparées par des espaces.
TRUSTED_PROXIES=192.0.2.10

# Interface et port du serveur sur lesquels Nextcloud publie son HTTP.
# Le reverse proxy redirige vers ce port, qui ne doit être joignable que par
# lui (pare-feu). 0.0.0.0 publie sur toutes les interfaces : préférez
# l'adresse de l'interface tournée vers le proxy.
NEXTCLOUD_HTTP_BIND=192.0.2.20
NEXTCLOUD_HTTP_PORT=8080

# --- Partage NFS de l'École (prérequis #6) ------------------------------------

# Adresse du serveur NFS et chemin de l'export qui reçoit le dossier de
# données de Nextcloud (les Documents). L'export doit être accessible en
# lecture et écriture par l'UID/GID 33 (www-data).
NFS_SERVER=192.0.2.30
NFS_EXPORT_PATH=/export/nextcloud
# Options de montage NFS (version du protocole, etc.).
NFS_MOUNT_OPTIONS=nfsvers=4.1,rw,hard

# --- Compte administrateur de Nextcloud ---------------------------------------

# Compte créé à l'installation, membre du groupe technique « admin ».
NEXTCLOUD_ADMIN_USER=administrateur
NEXTCLOUD_ADMIN_PASSWORD=exemple-mot-de-passe-administrateur

# --- MariaDB ------------------------------------------------------------------

MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=exemple-mot-de-passe-mariadb
MYSQL_ROOT_PASSWORD=exemple-mot-de-passe-root-mariadb

# --- Redis --------------------------------------------------------------------

REDIS_HOST_PASSWORD=exemple-mot-de-passe-redis

# --- PHP ----------------------------------------------------------------------

# Taille maximale d'un envoi de Document. Le reverse proxy de l'École doit
# accepter au moins cette taille (prérequis #7).
PHP_UPLOAD_LIMIT=2G
PHP_MEMORY_LIMIT=1G
